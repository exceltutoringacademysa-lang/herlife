# Browser-safe Supabase credentials only. Do not commit .env.local.
# Find these in your Supabase project > Connect (or Settings > API Keys).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Older deployments may use VITE_SUPABASE_ANON_KEY instead.
# NEVER place a secret key, service_role key or database password in VITE_ variables.
